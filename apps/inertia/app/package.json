{
  "name": "@alloy/inertia-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../../.. exec vp run inertia:dev",
    "build": "pnpm --dir ../../.. exec vp run inertia:build",
    "typecheck": "pnpm --dir ../../.. exec vp exec tsc -p apps/inertia/app/tsconfig.json --noEmit",
    "fmt": "pnpm --dir ../../.. exec vp fmt apps/inertia/app",
    "fmt:check": "pnpm --dir ../../.. exec vp fmt --check apps/inertia/app"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "@radix-icons/vue": "^1.0.0",
    "@tabler/icons-vue": "^3.41.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.4",
    "@unovis/vue": "^1.6.4",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.9.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0"
  }
}
