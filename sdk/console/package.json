      "default": "./dist/prompts/suggest/index.js"
    },
    "./prompts/text": {
      "types": "./dist/prompts/text.d.ts",
      "import": "./dist/prompts/text.js",
      "default": "./dist/prompts/text.js"
    },
    "./prompts/textarea": {
      "types": "./dist/prompts/textarea.d.ts",
      "import": "./dist/prompts/textarea.js",
      "default": "./dist/prompts/textarea.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "import": "./dist/status.js",
      "default": "./dist/status.js"
    },
    "./status/progress": {
      "types": "./dist/status/progress.d.ts",
      "import": "./dist/status/progress.js",
      "default": "./dist/status/progress.js"
    },
    "./status/spinner": {
      "types": "./dist/status/spinner.d.ts",
      "import": "./dist/status/spinner.js",
      "default": "./dist/status/spinner.js"
    },
    "./status/stream": {
      "types": "./dist/status/stream.d.ts",
      "import": "./dist/status/stream.js",
      "default": "./dist/status/stream.js"
    },
    "./status/task": {
      "types": "./dist/status/task.d.ts",
      "import": "./dist/status/task.js",
      "default": "./dist/status/task.js"
    },
    "./strings": {
      "types": "./dist/strings.d.ts",
      "import": "./dist/strings.js",
      "default": "./dist/strings.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.js",
      "default": "./dist/terminal.js"
    },
    "./typed-value": {
      "types": "./dist/typed-value.d.ts",
      "import": "./dist/typed-value.js",
      "default": "./dist/typed-value.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "imports": {
    "#console/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "#console/prompts/*": {
      "types": "./dist/prompts/*.d.ts",
      "default": "./dist/prompts/*.js"
    }
  },
  "scripts": {
    "build": "bash -lc 'source ../../infra/scripts/tasks/cache-env.sh && rm -rf dist \"${ALLOY_CACHE_PATH}/tsbuild/console-build.tsbuildinfo\" && tsc -p tsconfig.build.json'",
    "prepack": "pnpm build",
    "test": "bash -lc 'source ../../infra/scripts/tasks/cache-env.sh && vp test run'",
    "typecheck": "bash -lc 'source ../../infra/scripts/tasks/cache-env.sh && tsc -p tsconfig.json --noEmit'"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
