{
	"extends": "../../infra/tsconfig/base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "../../infra/.cache/tsbuild/httpx.tsbuildinfo",
		"types": ["node"],
		"paths": {
			"@hara/sdk-httpx": ["./src/index.ts"],
			"@hara/sdk-httpx/*": ["./src/*"],
			"#httpx/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
