{
	"name": "@hara/sdk-workflow",
	"version": "0.4.0",
	"private": true,
	"publishConfig": {
		"access": "restricted",
		"registry": "https://hara.sh/npm/"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oullin/alloy.git",
		"directory": "sdk/workflow"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./audit": {
			"types": "./dist/audit.d.ts",
			"import": "./dist/audit.js",
			"default": "./dist/audit.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js",
			"default": "./dist/config.js"
		},
		"./events": {
			"types": "./dist/events.d.ts",
			"import": "./dist/events.js",
			"default": "./dist/events.js"
		},
		"./multisteps": {
			"types": "./dist/multisteps.d.ts",
			"import": "./dist/multisteps.js",
			"default": "./dist/multisteps.js"
		},
		"./registry": {
			"types": "./dist/registry.d.ts",
			"import": "./dist/registry.js",
			"default": "./dist/registry.js"
		},
		"./stores": {
			"types": "./dist/stores.d.ts",
			"import": "./dist/stores.js",
			"default": "./dist/stores.js"
		},
		"./validator": {
			"types": "./dist/validator.d.ts",
			"import": "./dist/validator.js",
			"default": "./dist/validator.js"
		}
	},
	"imports": {
		"#workflow/*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "bash -lc 'source ../../infra/scripts/tasks/cache-env.sh && rm -rf dist \"${ALLOY_CACHE_PATH}/tsbuild/workflow-build.tsbuildinfo\" && tsc -b tsconfig.build.json --force'",
		"build:package": "rm -rf dist && tsc -p tsconfig.package.json",
		"prepare": "pnpm build:package",
		"prepack": "pnpm build",
		"test": "bash -lc 'source ../../infra/scripts/tasks/cache-env.sh && vp test run tests'",
		"typecheck": "bash -lc 'source ../../infra/scripts/tasks/cache-env.sh && tsc -p tsconfig.json --noEmit'"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"typescript": "^7.0.2"
	}
}
