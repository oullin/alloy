# Inertia demo API environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# INERTIA_CRYPTO_KEY (required)
# Base64-encoded 32-byte AES-256 key used for session cookie encryption, CSRF,
# and the flash store. The application fails fast at startup if this is unset.
# Generate a fresh value with a CSPRNG, e.g.:
#   openssl rand -base64 32
#
# SECURITY: A previous version of this demo committed a static key to the repo.
# That key is permanently compromised. Any environment that ever ran with it
# must rotate to a new key (regenerate below) and invalidate all cookies signed
# with the old one. Do not reuse the old value.
INERTIA_CRYPTO_KEY=

# INERTIA_DEMO_SEED_PASSWORD (optional)
# Password assigned to the seeded demo users. If unset, the seeder uses the
# well-known default "12345678" (a deliberate owner decision for demo
# convenience — this is demo data, not a real credential). Set an explicit
# value to override it for your environment.
INERTIA_DEMO_SEED_PASSWORD=
