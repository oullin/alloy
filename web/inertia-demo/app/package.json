{
  "name": "@alloy/inertia-demo-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../../.. exec vp run inertia-demo:dev",
    "build": "pnpm --dir ../../.. exec vp run inertia-demo:build",
    "typecheck": "pnpm --dir ../../.. exec vp exec tsc -p web/inertia-demo/app/tsconfig.json --noEmit",
    "fmt": "pnpm --dir ../../.. exec vp fmt web/inertia-demo/app",
    "fmt:check": "pnpm --dir ../../.. exec vp fmt --check web/inertia-demo/app"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.6.1",
    "@radix-icons/vue": "^1.0.0",
    "@tabler/icons-vue": "^3.41.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.4",
    "@unovis/vue": "^1.6.4",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.9.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7"
  }
}
