{
  "name": "@alloy/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tsconfig/*.json": "./tsconfig/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "parity:audit": "tsx src/parity-audit.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
