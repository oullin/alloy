{
  "name": "@alloy/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tsconfig/*.json": "./tsconfig/*.json"
  },
  "scripts": {
    "build": "bash -lc 'source scripts/tasks/cache-env.sh && tsc -p tsconfig.json'",
    "lint": "bash -lc 'source scripts/tasks/cache-env.sh && tsc -p tsconfig.json --noEmit'",
    "test": "bash -lc 'source scripts/tasks/cache-env.sh && vp test run --passWithNoTests'",
    "typecheck": "bash -lc 'source scripts/tasks/cache-env.sh && tsc -p tsconfig.json --noEmit'"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
