{
  "name": "@alloy/tempo-acceptance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#acceptance/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run --passWithNoTests",
    "test:tempo": "vp test run src/tempo.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@alloy/tempo": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
