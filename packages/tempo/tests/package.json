{
  "name": "@alloy/tempo-acceptance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#acceptance/*": "./src/*.ts"
  },
  "scripts": {
    "build": "bash -lc 'source ../../../infra/scripts/tasks/cache-env.sh && tsc -p tsconfig.json'",
    "lint": "bash -lc 'source ../../../infra/scripts/tasks/cache-env.sh && tsc -p tsconfig.json --noEmit'",
    "test": "bash -lc 'source ../../../infra/scripts/tasks/cache-env.sh && vp test run --passWithNoTests'",
    "test:tempo": "bash -lc 'source ../../../infra/scripts/tasks/cache-env.sh && vp test run src/tempo.test.ts'",
    "typecheck": "bash -lc 'source ../../../infra/scripts/tasks/cache-env.sh && tsc -p tsconfig.json --noEmit'"
  },
  "dependencies": {
    "@alloy/tempo": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
