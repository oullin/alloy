{
  "name": "@alloy/tempo",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bash -lc 'source ../../infra/scripts/tasks/cache-env.sh && cd \"${ALLOY_ROOT_PATH}\" && vp pack'",
    "lint": "bash -lc 'source ../../infra/scripts/tasks/cache-env.sh && tsc -p tsconfig.json --noEmit'",
    "prepublishOnly": "pnpm build",
    "test": "pnpm --filter @alloy/tempo-acceptance test:tempo",
    "typecheck": "bash -lc 'source ../../infra/scripts/tasks/cache-env.sh && tsc -p tsconfig.json --noEmit'"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
