{
  "name": "@alloy/jsonx-go",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../../infra/.cache/turbo/dist/jsonx && go build ./... && touch ../../../infra/.cache/turbo/dist/jsonx/.build-stamp'",
    "dev": "go test -race ./... -count=1",
    "test": "go test -race ./...",
    "test:coverage": "sh -c 'mkdir -p ../../../infra/.cache/coverage/go/jsonx && go test -race ./... -coverprofile=../../../infra/.cache/coverage/go/jsonx/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "echo gofmt handled by root go-fmt sweep",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
