{
  "name": "alloy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "docs:build": "vp run -F @alloy/docs --fail-if-no-match build",
    "docs:dev": "vp run -F @alloy/docs --fail-if-no-match dev",
    "imports:check": "vp run check:imports",
    "inertia-demo:build": "vp run inertia-demo-app:build",
    "inertia-demo:dev": "vp run inertia-demo-app:dev",
    "inertia:build": "pnpm inertia-demo:build",
    "inertia:dev": "pnpm inertia-demo:dev",
    "lint": "vp lint && vp run check:imports",
    "test": "vp test",
    "test:e2e:inertia": "pnpm test:e2e:inertia-demo",
    "test:e2e:inertia-demo": "vp run inertia-demo:e2e",
    "typecheck": "vp check",
    "web:build": "pnpm docs:build",
    "web:dev": "pnpm docs:dev"
  },
  "devDependencies": {
    "@alloy/infra": "workspace:*",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite",
        "vitest"
      ],
      "allowedVersions": {
        "vite": "*",
        "vitest": "*"
      }
    }
  }
}
